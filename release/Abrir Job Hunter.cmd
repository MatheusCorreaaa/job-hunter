@echo off
setlocal
set "JOB_HUNTER_APP=%~dp0app"
powershell.exe -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; $arch='x64'; if($env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64'){$arch='arm64'}; $version='43.8.12'; $root=Join-Path $env:LOCALAPPDATA ('Job Hunter/runtime/'+$version+'-win-'+$arch); $exe=Join-Path $root 'electron.exe'; if((-not (Test-Path $exe)) -or (-not (Test-Path ($exe+'.ready')))){ $hashes=@{x64='5af2194e6b86fcad6d9f66d0a9c2158fecceaf1bd9518f43e68bd629dd3f6b9d'; arm64='b83aeaca07f3a5e2ac2087e9f9f4811d6f7ef20f025d62edccc0fbea6e57216f'}; $zip=Join-Path $env:TEMP ('job-hunter-'+[guid]::NewGuid()+'.zip'); Write-Host 'Baixando o Electron oficial para a primeira abertura...'; try { [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -UseBasicParsing ('https://github.com/electron/electron/releases/download/v'+$version+'/electron-v'+$version+'-win32-'+$arch+'.zip') -OutFile $zip; if ((Get-FileHash -Algorithm SHA256 $zip).Hash -ne $hashes[$arch]) {throw 'O arquivo baixado nao corresponde a distribuicao oficial.'}; New-Item -ItemType Directory -Force $root | Out-Null; Expand-Archive -LiteralPath $zip -DestinationPath $root -Force; New-Item -ItemType File -Force ($exe+'.ready') | Out-Null } finally { Remove-Item -LiteralPath $zip -ErrorAction SilentlyContinue } }; Start-Process -FilePath $exe -ArgumentList ([char]34+$env:JOB_HUNTER_APP+[char]34)"
if errorlevel 1 pause
